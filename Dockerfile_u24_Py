#################### Global Build ARGs ####################
ARG IMAGE_TAG="ubuntu:noble"

################### Base Image  ###################
FROM ${IMAGE_TAG}
ARG IMAGE_TAG
ENV IMAGE_TAG=${IMAGE_TAG}
ARG BUILD_INFO_DIR="/.build_info"

################### Variables ##################
# Copy custom codes and templates, update ENV for ready access
ARG  CUSTOM_DIR_SRC='../image_customizations'
ARG  CUSTOM_DIR_DST="/shadowbox"

COPY "${CUSTOM_DIR_SRC}/omp_themes" "${CUSTOM_DIR_DST}/omp_themes"
COPY "${CUSTOM_DIR_SRC}/scripts" "${CUSTOM_DIR_DST}/scripts"

# Within the container, where to install apps like Conda, etc.
ARG  APP_INSTALL_DIR="/usr/bin"

# Install essential CLI tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential ca-certificates \
        wget curl \
        nano micro vim less bat\
        libglib2.0-0 software-properties-common \
        procps tree htop tmux\
        zip bzip2 unzip xz-utils \
        iputils-ping net-tools \
        openssh-server ssh-client \
        fuse \
        git \
        sudo \
        zsh -y && \
    apt-get clean

# Install Bash and Zsh customization themes
RUN     ln -s batcat /usr/bin/bat &&\
        curl -k -s https://ohmyposh.dev/install.sh | bash -s -- -d /usr/bin -t "${CUSTOM_DIR_DST}/omp_themes" &&\
        echo "########## Customization for Oh-My-Posh Bash themes ##########" >> ~/.bashrc &&\
        echo "eval \"\$(oh-my-posh init bash --config ${CUSTOM_DIR_DST}/omp_themes/sbp_clean_detailed.omp.json)\"" >> ~/.bashrc &&\
        echo "eval \"${CUSTOM_DIR_DST}/scripts/terminal_logo.sh\"" >> ~/.bashrc &&\
        echo "########## Customization for Oh-My-Posh Zsh themes ##########" >> ~/.zshrc &&\
        echo "eval \"\$(oh-my-posh init zsh --config ${CUSTOM_DIR_DST}/omp_themes/sbp_clean_detailed.omp.json)\"" >> ~/.zshrc &&\
        echo "eval \"${CUSTOM_DIR_DST}/scripts/terminal_logo.sh\"" >> ~/.zshrc

# # Anaconda installation and initialization
# # Get Miniconda version as ARG, default to latest
ARG  MINICONDA_FILE="Miniconda3-latest-Linux-x86_64.sh"
ARG  INSTALL_CONDA_ENVS_LATEST=""
ENV  PYTHONPATH="${CUSTOM_DIR_DST}/code/"

RUN     wget --no-check-certificate https://repo.anaconda.com/miniconda/$MINICONDA_FILE  &&\
        chmod 755 $MINICONDA_FILE &&\
        ./$MINICONDA_FILE -p $APP_INSTALL_DIR/miniconda3 -b &&\
        rm $MINICONDA_FILE &&\
        ln -s $APP_INSTALL_DIR/miniconda3/bin/conda /$APP_INSTALL_DIR/conda &&\
        ln -s $APP_INSTALL_DIR/miniconda3/bin/pip /$APP_INSTALL_DIR/pip &&\
        conda init bash &&\
        conda clean --all -y &&\
        conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main &&\
        conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

        # mkdir -p $HOME/miniconda3/etc/conda/activate.d &&\
        # echo 'export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$HOME/miniconda3/lib/' > $HOME/miniconda3/etc/conda/activate.d/env_vars.sh

# Install uv package installer
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
   ln -s $HOME/.cargo/bin/uv /usr/bin/uv

## Create a directory to hold the environment files of the installed conda environment
COPY "${CUSTOM_DIR_SRC}/conda_envs" "${CUSTOM_DIR_DST}/conda_envs"
RUN mkdir -p "${CUSTOM_DIR_DST}/conda_envs/installed"

## Install the latest version of each conda environment from input
RUN if [ -n "${INSTALL_CONDA_ENVS_LATEST}" ]; then \
        echo "Installing Conda environments: ${INSTALL_CONDA_ENVS_LATEST}"; \
        for env_name in ${INSTALL_CONDA_ENVS_LATEST}; do \
            ENV_FILE="${CUSTOM_DIR_DST}/conda_envs/latest/${env_name}_env.yml"; \
            ENV_FILE_TO_EXPORT="${CUSTOM_DIR_DST}/conda_envs/installed/${env_name}_env_$(date -u +"%Y%m%d").yml"; \
            if [ -f "$ENV_FILE" ]; then \
                echo "Creating environment '$env_name' from '$ENV_FILE'"; \
                conda env create -f "$ENV_FILE" --yes; \
                echo "Exporting environment '$env_name' to ${CUSTOM_DIR_DST}/conda_envs/installed/ directory"; \
                # Export the environment specification
                conda env export -n "$env_name" > "$ENV_FILE_TO_EXPORT"; \
                # bat "$ENV_FILE_TO_EXPORT"; \
            else \
                echo "Warning: Environment file '$ENV_FILE' not found for '$env_name'. Skipping."; \
                #exit 1; \
            fi; \
        done; \
        echo "Cleaning Conda cache after all environments are installed."; \
        conda clean --all -y; \
        pip cache purge; \
    else \
        echo "No specific Conda environments requested via INSTALL_CONDA_ENVS. Skipping environment creation."; \
    fi

## Install the pinned version of each conda environment from input
ARG  INSTALL_CONDA_ENVS_PINNED=""

RUN if [ -n "${INSTALL_CONDA_ENVS_PINNED}" ]; then \
        echo "Installing Conda environments: ${INSTALL_CONDA_ENVS_PINNED}"; \
        for env_name in ${INSTALL_CONDA_ENVS_PINNED}; do \
            ENV_FILE="${CUSTOM_DIR_DST}/conda_envs/pinned/${env_name}_env.yml"; \
            if [ -f "$ENV_FILE" ]; then \
                echo "Creating environment '$env_name' from '$ENV_FILE'"; \
                conda env create -f "$ENV_FILE" --yes; \
            else \
                echo "Warning: Environment file '$ENV_FILE' not found for '$env_name'. Skipping."; \
                #exit 1; \
            fi; \
        done; \
        echo "Cleaning Conda cache after all environments are installed."; \
        conda clean --all -y; \
        pip cache purge; \
    else \
        echo "No specific Conda environments requested via INSTALL_CONDA_ENVS. Skipping environment creation."; \
    fi

## Create build info file for deterministic builds
RUN mkdir -p ${BUILD_INFO_DIR} && \
    echo "========== Build Information ==========" > ${BUILD_INFO_DIR}/summary.txt && \
    echo "Build Date: $(date -u +'%Y-%m-%d %H:%M:%S UTC')" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "========== ARG Variables ==========" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "IMAGE_TAG: ${IMAGE_TAG}" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "CUSTOM_DIR_SRC: ${CUSTOM_DIR_SRC}" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "CUSTOM_DIR_DST: ${CUSTOM_DIR_DST}" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "APP_INSTALL_DIR: ${APP_INSTALL_DIR}" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "MINICONDA_FILE: ${MINICONDA_FILE}" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "INSTALL_CONDA_ENVS_LATEST: ${INSTALL_CONDA_ENVS_LATEST}" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "INSTALL_CONDA_ENVS_PINNED: ${INSTALL_CONDA_ENVS_PINNED}" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "========== ENV Variables ==========" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "PYTHONPATH: ${PYTHONPATH}" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "========== Tool Versions ==========" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "Conda Version:" >> ${BUILD_INFO_DIR}/summary.txt && \
    conda --version >> ${BUILD_INFO_DIR}/summary.txt 2>&1 && \
    echo "" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "Python Version:" >> ${BUILD_INFO_DIR}/summary.txt && \
    conda run python --version >> ${BUILD_INFO_DIR}/summary.txt 2>&1 && \
    echo "" >> ${BUILD_INFO_DIR}/summary.txt && \
    # echo "uv Version:" >> ${BUILD_INFO_DIR}/summary.txt && \
    # /usr/bin/uv --version >> ${BUILD_INFO_DIR}/summary.txt 2>&1 && \
    # echo "" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "Oh-My-Posh Version:" >> ${BUILD_INFO_DIR}/summary.txt && \
    oh-my-posh --version >> ${BUILD_INFO_DIR}/summary.txt 2>&1 && \
    echo "" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "Zsh Version:" >> ${BUILD_INFO_DIR}/summary.txt && \
    zsh --version >> ${BUILD_INFO_DIR}/summary.txt 2>&1 && \
    echo "" >> ${BUILD_INFO_DIR}/summary.txt && \
    echo "========== Installed Conda Environments ==========" >> ${BUILD_INFO_DIR}/summary.txt && \
    if [ -n "${INSTALL_CONDA_ENVS_LATEST}" ] || [ -n "${INSTALL_CONDA_ENVS_PINNED}" ]; then \
        echo "Latest Environments: ${INSTALL_CONDA_ENVS_LATEST}" >> ${BUILD_INFO_DIR}/summary.txt && \
        echo "Pinned Environments: ${INSTALL_CONDA_ENVS_PINNED}" >> ${BUILD_INFO_DIR}/summary.txt && \
        echo "" >> ${BUILD_INFO_DIR}/summary.txt; \
    else \
        echo "No custom environments installed" >> ${BUILD_INFO_DIR}/summary.txt; \
    fi && \
    cp ${CUSTOM_DIR_DST}/conda_envs/installed/*.yml ${BUILD_INFO_DIR}/ 2>/dev/null || true

