#################### Global Build ARGs ####################
ARG IMAGE_TAG="ubuntu:noble"

################### Base Image  ###################
FROM ${IMAGE_TAG}
ARG IMAGE_TAG
ENV IMAGE_TAG=${IMAGE_TAG}

################## Other ARGs ################
ARG CUSTOM_DIR_SRC='../image_customizations'
ARG CUSTOM_DIR_DST="/fhai"
ARG APP_INSTALL_DIR="/usr/bin"
ARG BUILD_INFO_DIR="/.build_info"
ARG INSTALL_AZURE_CLI=false

################### Install essential CLI tools ###################
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential ca-certificates \
        wget curl \
        nano micro vim less bat \
        libglib2.0-0 software-properties-common \
        procps tree htop tmux \
        zip bzip2 unzip xz-utils \
        iputils-ping net-tools \
        openssh-server ssh-client \
        fuse \
        git \
        sudo \
        zsh && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

################### Copy custom codes and templates ###################
COPY "${CUSTOM_DIR_SRC}/omp_themes" "${CUSTOM_DIR_DST}/omp_themes"
COPY "${CUSTOM_DIR_SRC}/scripts" "${CUSTOM_DIR_DST}/scripts"

################### Install Bash and Zsh customization themes ###################
RUN ln -s batcat /usr/bin/bat && \
    curl -fsSL https://ohmyposh.dev/install.sh -o /tmp/install_omp.sh && \
    bash /tmp/install_omp.sh -d /usr/bin -t "${CUSTOM_DIR_DST}/omp_themes" && \
    rm /tmp/install_omp.sh && \
    echo "########## Customization for Oh-My-Posh Bash themes ##########" >> ~/.bashrc && \
    echo "eval \"\$(oh-my-posh init bash --config ${CUSTOM_DIR_DST}/omp_themes/sbp_clean_detailed.omp.json)\"" >> ~/.bashrc && \
    echo "eval \"${CUSTOM_DIR_DST}/scripts/terminal_logo.sh\"" >> ~/.bashrc && \
    echo "########## Customization for Oh-My-Posh Zsh themes ##########" >> ~/.zshrc && \
    echo "eval \"\$(oh-my-posh init zsh --config ${CUSTOM_DIR_DST}/omp_themes/sbp_clean_detailed.omp.json)\"" >> ~/.zshrc && \
    echo "eval \"${CUSTOM_DIR_DST}/scripts/terminal_logo.sh\"" >> ~/.zshrc


################### Python installation related ARGs #####################
ARG MINICONDA_FILE="Miniconda3-latest-Linux-x86_64.sh"
ARG PYTHONPATH="${CUSTOM_DIR_DST}/code/"
ENV PYTHONPATH=${PYTHONPATH}

################### Miniconda installation and initialization ###################
RUN wget https://repo.anaconda.com/miniconda/$MINICONDA_FILE && \
    chmod 755 $MINICONDA_FILE && \
    ./$MINICONDA_FILE -p $APP_INSTALL_DIR/miniconda3 -b && \
    rm $MINICONDA_FILE && \
    ln -s $APP_INSTALL_DIR/miniconda3/bin/conda /$APP_INSTALL_DIR/conda && \
    ln -s $APP_INSTALL_DIR/miniconda3/bin/pip /$APP_INSTALL_DIR/pip && \
    conda init --all && \
    conda clean --all -y && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

# NOTE: If build fails due to certificate issues (common behind corporate firewalls),
# add --no-check-certificate flag to wget command above:
# RUN wget --no-check-certificate https://repo.anaconda.com/miniconda/$MINICONDA_FILE && \

################### Install uv package installer ###################
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    ln -s /root/.local/bin/uv $APP_INSTALL_DIR/uv
    # rm -rf /root/.rustup || true

################### Create directory for conda environment files ###################
COPY "${CUSTOM_DIR_SRC}/conda_envs" "${CUSTOM_DIR_DST}/conda_envs"
RUN mkdir -p "${CUSTOM_DIR_DST}/conda_envs/installed"

################### Install conda environments (latest and pinned versions) ###################
ARG INSTALL_CONDA_ENVS_LATEST=""
ARG INSTALL_CONDA_ENVS_PINNED=""

RUN set -e && \
    if [ -n "${INSTALL_CONDA_ENVS_LATEST}" ] || [ -n "${INSTALL_CONDA_ENVS_PINNED}" ]; then \
        echo "Installing Conda environments:"; \
        echo "Latest: ${INSTALL_CONDA_ENVS_LATEST}"; \
        echo "Pinned: ${INSTALL_CONDA_ENVS_PINNED}"; \
        \
        # Install latest environments \
        if [ -n "${INSTALL_CONDA_ENVS_LATEST}" ]; then \
            for env_name in ${INSTALL_CONDA_ENVS_LATEST}; do \
                ENV_FILE_PATH_SRC="${CUSTOM_DIR_DST}/conda_envs/latest/${env_name}_env.yml"; \
                if [ -f "$ENV_FILE_PATH_SRC" ]; then \
                    echo "Creating latest environment '$env_name' from '$ENV_FILE_PATH_SRC'"; \
                    conda env create -f "$ENV_FILE_PATH_SRC" --yes; \
                    echo "Exporting environment '$env_name' to ${CUSTOM_DIR_DST}/conda_envs/installed/ directory"; \
                    ENV_NAME_INSTALLED=$(grep '^[[:space:]]*name:' "$ENV_FILE_PATH_SRC" | awk -F: '{print $2}' | tr -d '\r\n' | xargs); \
                    ENV_FILE_PATH_DST="${CUSTOM_DIR_DST}/conda_envs/installed/${ENV_NAME_INSTALLED}_$(date -u +"%Y%m%d")_env.yml"; \
                    conda env export -n "$ENV_NAME_INSTALLED" | grep -v "^prefix: " > "$ENV_FILE_PATH_DST"; \
                else \
                    echo "Warning: Latest environment file '$ENV_FILE_PATH_SRC' not found for '$env_name'. Skipping."; \
                fi; \
            done; \
        fi; \
        \
        # Install pinned environments \
        if [ -n "${INSTALL_CONDA_ENVS_PINNED}" ]; then \
            for env_name in ${INSTALL_CONDA_ENVS_PINNED}; do \
                ENV_FILE_PATH_SRC="${CUSTOM_DIR_DST}/conda_envs/pinned/${env_name}_env.yml"; \
                if [ -f "$ENV_FILE_PATH_SRC" ]; then \
                    echo "Creating pinned environment '$env_name' from '$ENV_FILE_PATH_SRC'"; \
                    conda env create -f "$ENV_FILE_PATH_SRC" --yes; \
                    echo "Exporting environment '$env_name' to ${CUSTOM_DIR_DST}/conda_envs/installed/ directory"; \
                    ENV_NAME_INSTALLED=$(grep '^[[:space:]]*name:' "$ENV_FILE_PATH_SRC" | awk -F: '{print $2}' | tr -d '\r\n' | xargs); \
                    ENV_FILE_PATH_DST="${CUSTOM_DIR_DST}/conda_envs/installed/${ENV_NAME_INSTALLED}_$(date -u +"%Y%m%d")_env.yml"; \
                    conda env export -n "$ENV_NAME_INSTALLED" | grep -v "^prefix: " > "$ENV_FILE_PATH_DST"; \
                else \
                    echo "Warning: Pinned environment file '$ENV_FILE_PATH_SRC' not found for '$env_name'. Skipping."; \
                fi; \
            done; \
        fi; \
        \
        echo "Cleaning Conda cache after all environments are installed."; \
        conda clean --all -y; \
        pip cache purge; \
    else \
        echo "No Conda environments requested via INSTALL_CONDA_ENVS_LATEST or INSTALL_CONDA_ENVS_PINNED. Skipping environment creation."; \
    fi

################### Install Azure CLI ###################
RUN if [ "${INSTALL_AZURE_CLI}" = "true" ]; then \
        echo "Installing Azure CLI..."; \
        if curl -sL https://aka.ms/InstallAzureCLIDeb | bash && az extension add -n ml -y; then \
            echo "Azure CLI installed successfully with ML extension."; \
        else \
            echo "Warning: Azure CLI installation or ML extension addition failed."; \
        fi; \
    else \
        echo "Skipping Azure CLI installation."; \
    fi

################### Create build info file for deterministic builds ###################
RUN mkdir -p ${BUILD_INFO_DIR} && \
    { \
        echo "========== Build Information =========="; \
        echo "Build Date: $(date -u +'%Y-%m-%d %H:%M:%S UTC')"; \
        echo ""; \
        echo "========== ARG Variables =========="; \
        echo "IMAGE_TAG: ${IMAGE_TAG}"; \
        echo "CUSTOM_DIR_SRC: ${CUSTOM_DIR_SRC}"; \
        echo "CUSTOM_DIR_DST: ${CUSTOM_DIR_DST}"; \
        echo "APP_INSTALL_DIR: ${APP_INSTALL_DIR}"; \
        echo "MINICONDA_FILE: ${MINICONDA_FILE}"; \
        echo "INSTALL_CONDA_ENVS_LATEST: ${INSTALL_CONDA_ENVS_LATEST}"; \
        echo "INSTALL_CONDA_ENVS_PINNED: ${INSTALL_CONDA_ENVS_PINNED}"; \
        echo "INSTALL_AZURE_CLI: ${INSTALL_AZURE_CLI}"; \
        echo ""; \
        echo "========== ENV Variables =========="; \
        echo "PYTHONPATH: ${PYTHONPATH}"; \
        echo ""; \
        echo "========== Tool Versions =========="; \
        echo "Conda Version:"; \
        conda --version 2>&1; \
        echo ""; \
        echo "Python Version:"; \
        conda run python --version 2>&1; \
        echo ""; \
        echo "uv Version:"; \
        $APP_INSTALL_DIR/uv --version 2>&1; \
        echo ""; \
        echo "Oh-My-Posh Version:"; \
        oh-my-posh --version 2>&1; \
        echo ""; \
        echo "Zsh Version:"; \
        zsh --version 2>&1; \
        echo ""; \
        if [ "${INSTALL_AZURE_CLI}" = "true" ]; then \
            echo "Azure CLI Version:"; \
            if command -v az >/dev/null 2>&1; then \
                az --version 2>&1; \
            else \
                echo "Azure CLI binary not found."; \
            fi; \
            echo ""; \
        fi; \
        echo "========== Installed Conda Environments =========="; \
        if [ -n "${INSTALL_CONDA_ENVS_LATEST}" ] || [ -n "${INSTALL_CONDA_ENVS_PINNED}" ]; then \
            echo "Latest Environments: ${INSTALL_CONDA_ENVS_LATEST}"; \
            echo "Pinned Environments: ${INSTALL_CONDA_ENVS_PINNED}"; \
            echo ""; \
        else \
            echo "No custom environments installed"; \
        fi; \
    } > ${BUILD_INFO_DIR}/summary.txt && \
    cp ${CUSTOM_DIR_DST}/conda_envs/installed/*.yml ${BUILD_INFO_DIR}/ 2>/dev/null || true
